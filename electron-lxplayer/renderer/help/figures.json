  },
  "map.png": {
    "query": "view=sound-map",
    "points": [
      {
        "selector": ".sound-map-toolbar",
        "label": "切换全库、单曲与轨迹视角"
      },
      {
        "selector": ".sound-map-stage",
        "label": "缩放、旋转、平移和选歌"
