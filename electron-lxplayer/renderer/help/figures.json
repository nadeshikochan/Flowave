  },
  "sound.png": {
    "query": "view=settings&tab=general",
    "openEqualizer": true,
    "clip": ".equalizer-dialog",
    "points": [
      {
        "selector": ".equalizer-toolbar label",
        "label": "总开关用于试听对照"
      },
      {
        "selector": ".equalizer-band input",
        "label": "每个频段分别提升或衰减"
      },
      {
        "selector": ".equalizer-dialog .form-row",
        "label": "前置增益调整进入处理前的电平"
      }
    ]
  },
  "processing.png": {
    "query": "view=insights",
    "openProcessing": true,
    "clip": ".analysis-processing",
    "points": [
      {
        "selector": ".analysis-processing select",
        "label": "选择歌曲标签或段落结构"
      },
      {
        "selector": ".analysis-processing .analysis-actions button",
