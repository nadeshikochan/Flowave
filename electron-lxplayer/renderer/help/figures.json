{
  "library.png": {
    "query": "view=library",
    "points": [
      {
        "selector": ".nav-primary .nav-btn:first-child",
        "label": "歌曲与歌单在左侧切换"
      },
      {
        "selector": ".library-toolbar",
        "label": "在这里搜索歌名、歌手或专辑"
      },
      {
        "selector": ".player .cover",
        "label": "点击底部封面打开歌词"
      },
      {
        "selector": ".nav-footer button[title^='使用手册']",
        "label": "使用手册随时可查"
      }
    ]
  },
  "library-settings.png": {
    "query": "view=settings&tab=library-settings",
    "points": [
      {
        "selector": ".library-folder-actions .mini",
        "label": "添加音乐文件夹"
      },
      {
        "selector": ".library-folder-actions .primary",
        "label": "应用更改后载入曲库"
      }
    ]
  },
  "packages.png": {
    "query": "view=settings&tab=features",
    "points": [
      {
        "selector": ".feature-install-header > button",
        "label": "安装所需功能与匹配资源"
      },
      {
        "selector": ".feature-install-item details summary",
        "label": "展开查看计算环境与模型状态"
      }
    ]
  },
  "recommendation.png": {
    "query": "view=settings&tab=advanced",
    "points": [
      {
        "selector": ".settings-setup-links",
        "label": "按顺序完成推荐准备"
      },
      {
        "selector": "[data-setting-id='setting-advanced-72ce9b8c3f'] .btns .mini:nth-child(2)",
        "label": "更新推荐索引"
      },
      {
        "selector": ".settings-subnavigation button:nth-child(2)",
        "label": "索引完成后进入接歌规则"
      }
    ]
  },
  "lyrics.png": {
    "query": "view=library&scene=immersive",
    "points": [
      {
        "selector": ".lyric-back",
        "label": "返回歌曲列表"
      },
      {
        "selector": ".lyric-tools summary",
        "label": "歌词工具、音频详情与均衡器"
      }
    ]
  },
  "details.png": {
    "query": "view=library&scene=detail-info",
    "points": [
      {
        "selector": ".audio-detail-artists button",
        "label": "进入这个歌手的歌曲"
      },
      {
        "selector": ".audio-detail-discovery button",
        "label": "查询这首歌的相似列表"
      },
      {
        "selector": ".audio-detail-format",
        "label": "采样率、位深、码率和声道"
      }
    ]
  },
  "analysis.png": {
    "query": "view=analysis",
    "points": [
      {
        "selector": ".analysis-current-fragment",
        "label": "当前片段的局部特点"
      },
      {
        "selector": ".analysis-structure",
        "label": "歌曲段落及当前所在位置"
      },
      {
        "selector": ".analysis-summary",
        "label": "整曲标签与匹配强度"
      }
    ],
    "clip": ".insights-heading",
    "clipEnd": ".analysis-summary"
  },
  "filters.png": {
    "query": "view=insights",
    "clip": ".analysis-filters",
    "points": [
      {
        "selector": ".analysis-filter-choice > button",
        "label": "点击标签设为包含条件"
      },
      {
        "selector": ".analysis-filter-choice > button:nth-child(2)",
        "label": "用减号排除该特点"
      },
      {
        "selector": ".analysis-filters > .analysis-actions",
        "label": "选择是否包含未分析歌曲"
      }
    ]
  },
  "practice.png": {
    "query": "view=practice",
    "clip": ".practice-mixer",
    "points": [
      {
        "selector": ".practice-mixer .practice-actions .primary",
        "label": "载入已准备的分轨伴奏"
      },
      {
        "selector": ".practice-track input",
        "label": "分别调整各轨音量"
      },
      {
        "selector": ".practice-track button:last-child",
        "label": "独听选中的这一轨"
      }
    ]
  },
  "workspace.png": {
    "query": "view=settings&tab=storage",
    "points": [
      {
        "selector": "[data-setting-id='setting-workspaces'] .feature-storage-row",
        "label": "确认当前工作区目录"
      },
      {
